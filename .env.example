# Djangoの秘密鍵
DJANGO_SECRET_KEY=change-me-in-production

# 開発環境ではtrue、本番ではfalse
DJANGO_DEBUG=true

# Djangoがアクセスを許可するホスト
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# CSRF保護付きリクエストを許可するオリジン
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# DjangoのDB接続URL
DATABASE_URL=postgres://ns_shift:ns_shift_password@db:5432/ns_shift

# PostgresのDB名
POSTGRES_DB=ns_shift

# Postgresの接続ユーザー
POSTGRES_USER=ns_shift

# Postgresの接続パスワード
POSTGRES_PASSWORD=ns_shift_password

# コンテナ内のタイムゾーン
TZ=Asia/Tokyo

# ローカル開発用のOptimizer API。Django DEBUG=true のときに使用する。
LOCAL_OPTIMIZER_API_URL=http://host.docker.internal:8080

# 本番用Cloud Run Optimizer API。Django DEBUG=false のときに使用する。
OPTIMIZER_API_URL=
# ローカルAPI・Cloud Run APIの認証キー。実際の値は .env のみに設定する。
OPTIMIZER_API_KEY=
OPTIMIZER_API_TIMEOUT=330
